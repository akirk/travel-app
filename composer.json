{
    "name": "traveler/traveler",
    "description": "Traveler - A WordPress app powered by WpApp",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "akirk/wp-app": "^1.5.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Traveler\\": "src/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "version": "0.1.0",
    "authors": [
        {
            "name": "Alex Kirk"
        }
    ],
    "config": {
        "autoloader-suffix": "traveler"
